// 应用图标资源（安装包与窗口/任务栏图标共用）
#define IDI_ICON1 101
IDI_ICON1 ICON "app.ico"

// File version resource of the UI DLL (the host exe version comes from <Version> in the csproj).
1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Anlerway\0"
            VALUE "FileDescription", "FanControl UI\0"
            VALUE "FileVersion", "2.0.0\0"
            VALUE "InternalName", "FanControl.UI\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Anlerway\0"
            VALUE "OriginalFilename", "FanControl.UI.dll\0"
            VALUE "ProductName", "FanControl\0"
            VALUE "ProductVersion", "2.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
