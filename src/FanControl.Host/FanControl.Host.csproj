<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 单一进程：采样、控制、托盘、配置都在这里，界面是进程内加载的 FanControl.UI.dll
         （C++/Direct2D）。需要管理员权限（EC / ACPI / BLE 访问）。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>FanControl</AssemblyName>
    <RootNamespace>FanControl.Host</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <!-- 与界面 DLL 共用同一个图标：exe 有了它，资源管理器、任务栏、开始菜单、托盘
         （TrayHost 用 ExtractIconExW 取 exe 图标）才不用系统默认图标。 -->
    <ApplicationIcon>..\FanControl.UI.Cpp\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 界面 DLL 由 src/FanControl.UI.Cpp/build.bat 产出；有就拷到输出目录，没有则跳过
       （纯后台调试时不需要界面）。 -->
  <PropertyGroup>
    <NativeUiDll>$(MSBuildThisFileDirectory)..\FanControl.UI.Cpp\build\FanControl.UI.dll</NativeUiDll>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeUiDll)')">
    <None Include="$(NativeUiDll)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\FanControl.UI.Cpp\build\FanControl.UI.lib" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\FanControl.UI.Cpp\build\FanControl.UI.lib')" />
  </ItemGroup>

  <!-- 常驻小工具：让 GC 更积极地归还内存（服务器 GC 关闭 + 内存压力时收缩堆），
       界面关掉后进程仍住在托盘里，不该一直占着十几 MB 的空堆。 -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试工程直接覆盖界面协议层（ConfigPatch / StateJson / CommandRouter 是 internal）。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FanControl.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanControl.Service\FanControl.Service.csproj" />
    <ProjectReference Include="..\FanControl.Shared\FanControl.Shared.csproj" />
  </ItemGroup>

</Project>
